{
  "name": "@local/dsh-ssh",
  "version": "0.2.0",
  "private": true,
  "description": "SSH plugin for DSH: connection management, command execution, SFTP transfer, and a right-sidebar session workspace.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client",
    "scripts",
    "test",
    "locale",
    "examples",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "meta": {
    "title": "SSH",
    "description": "Manage SSH connections, run commands, drive an interactive PTY shell, and transfer files over SFTP from the DSH right sidebar."
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "cordis",
    "ssh",
    "sftp",
    "terminal"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "build": "npm run build:host && npm run build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:client",
    "test:unit": "node scripts/run-tests.mjs test/unit --test-concurrency=1 --test-timeout=30000",
    "test:client": "node scripts/run-tests.mjs test/client --test-concurrency=1 --test-timeout=30000",
    "test:integration": "node scripts/run-tests.mjs test/integration --test-concurrency=1 --test-timeout=60000",
    "test:perf": "node scripts/run-tests.mjs test/perf --test-concurrency=1 --test-timeout=600000",
    "test:real": "node --test --test-concurrency=1 --test-timeout=120000 test/integration/real-target.test.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "verify": "npm run typecheck && npm run build && npm test",
    "docs:shots": "node scripts/shot-files.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.3",
    "ssh2": "^1.16.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.3",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.0",
    "eslint": "^10.11.0",
    "linkedom": "^0.18.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0"
  }
}
